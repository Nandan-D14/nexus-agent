# E2B Desktop Sandbox
E2B_API_KEY=
REQUIRE_BYOK=false
BYOK_ENCRYPTION_KEY=
SHARED_ACCESS_CODE=
BETA_ENFORCE_BYOK=true
BETA_ADMIN_EMAILS=
BETA_GOOGLE_SHEET_ID=
BETA_GOOGLE_SHEET_NAME=beta_applications
SANDBOX_CREATE_RETRIES=3
SANDBOX_CREATE_RETRY_BACKOFF_SECONDS=2
SANDBOX_CREATE_RETRY_MAX_SECONDS=10

# Google / Gemini
GOOGLE_API_KEY=
GOOGLE_PROJECT_ID=
# IMPORTANT: Use "global" for Gemini 3 models (gemini-3.x), regional endpoints don't work
# Use "us-central1" or other regions only for Gemini 2.5 and earlier models
GOOGLE_CLOUD_REGION=global
BRAIN_MODEL=gemini-3.1-pro-preview
SIMPLE_TASK_FAST_PATH=true
FAST_SEARCH_CACHE_TTL_SECONDS=600
CURRENT_LOOKUP_CACHE_TTL_SECONDS=120
SCREENSHOT_AFTER_ACTION_DELAY_SECONDS=0.9

# Kilo / minimax (used for agent reasoning + tool calls)
KILO_API_KEY=
KILO_MODEL_ID=minimax/minimax-m2.5:free
KILO_GATEWAY_URL=https://api.kilo.ai/api/gateway

# Firebase Admin / Firestore
FIREBASE_PROJECT_ID=${FIREBASE_PROJECT_ID:?Set FIREBASE_PROJECT_ID}
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_AUTH_EMULATOR_HOST=
FIRESTORE_EMULATOR_HOST=

# Server
FRONTEND_URL=http://localhost:3000

# Session
SESSION_TIMEOUT_MINUTES=15
JWT_SECRET=dev-secret-change-in-production

# Durable production task runtime
TASK_WORKER_ENABLED=false
TASK_WORKER_AUTH_TOKEN=
TASK_WORKER_LEASE_SECONDS=600
TASK_EVENT_REPLAY_LIMIT=200
DEFAULT_AUTONOMY_MODE=manual
DEFAULT_TASK_BUDGET_CREDITS=1000
DEFAULT_TASK_MAX_RUNTIME_MINUTES=60
DEFAULT_TASK_MAX_TOOL_CALLS=80
IDLE_SANDBOX_PAUSE_SECONDS=300

# Cloud Tasks
GCP_TASKS_PROJECT_ID=
GCP_TASKS_LOCATION=us-central1
GCP_TASKS_QUEUE=cocomputer-tasks
GCP_TASKS_WORKER_URL=
GCP_TASKS_OIDC_SERVICE_ACCOUNT=
