# E2B Desktop Sandbox
E2B_API_KEY=
REQUIRE_BYOK=true
BYOK_ENCRYPTION_KEY=
SHARED_ACCESS_CODE=
SANDBOX_CREATE_RETRIES=3
SANDBOX_CREATE_RETRY_BACKOFF_SECONDS=2
SANDBOX_CREATE_RETRY_MAX_SECONDS=10

# Google / Gemini
GOOGLE_API_KEY=
GOOGLE_PROJECT_ID=
# IMPORTANT: Use "global" for Gemini 3 models (gemini-3.x), regional endpoints don't work
# Use "us-central1" or other regions only for Gemini 2.5 and earlier models
GOOGLE_CLOUD_REGION=global
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_APP_ID=
BRAIN_MODEL=gemini-3.1-pro-preview
# Fast path removed (docs/FULL_AGENT_ONLY_MIGRATION_PLAN.md) — every turn
# goes through the planner. Optional Phase B turn-budget classifier can reuse
# ROUTING_MODEL / ROUTING_FALLBACK_MODEL later.
ROUTING_MODEL=qwen3.5-flash
ROUTING_FALLBACK_MODEL=qwen3.5-plus
SCREENSHOT_AFTER_ACTION_DELAY_SECONDS=0.9

# Qwen-only reasoning, workers, and screenshot vision
MODEL_PROVIDER=qwen
QWEN_API_KEY=API_KEY
# Required for GLM on Model Studio International: replace WORKSPACE_ID.
# Keep this same base URL for Qwen and GLM text calls.
QWEN_API_BASE=https://WORKSPACE_ID.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
PLANNER_MODEL=glm-5.2
PLANNER_FALLBACK_MODELS=qwen3.5-plus,qwen3.6-plus
WORKER_MODEL=qwen3.7-max 
WORKER_FALLBACK_MODELS=qwen3.6-max-preview,qwen3.5-plus
WORKER_VISUAL_MODEL=qwen3.7-plus
WORKER_VISUAL_FALLBACK_MODELS=qwen3.5-omni-plus,qwen3.6-plus
MICRO_MODEL=qwen3.6-flash
MICRO_FALLBACK_MODELS=qwen3.5-flash
QWEN_VISION_MODEL=qwen3.7-plus
QWEN_VISION_FALLBACK_MODELS=qwen3.6-plus
QWEN_CAPABILITY_PROBE_ON_STARTUP=true

# Legacy Kilo settings (not used by the Qwen-only production path)
KILO_API_KEY=
KILO_MODEL_ID=minimax/minimax-m2.5:free
KILO_GATEWAY_URL=https://api.kilo.ai/api/gateway

# Firebase Admin / Firestore
FIREBASE_PROJECT_ID=${FIREBASE_PROJECT_ID:?Set FIREBASE_PROJECT_ID}
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_AUTH_EMULATOR_HOST=
FIRESTORE_EMULATOR_HOST=

# Server
FRONTEND_URL=http://localhost:3000

# Session
SESSION_TIMEOUT_MINUTES=15
JWT_SECRET=dev-secret-change-in-production-min-32-bytes-long

# Durable production task runtime
# When enabled, agent turns run detached from the WebSocket so closing the
# browser does not kill an in-flight run. Uses Cloud Tasks when configured
# below; otherwise falls back to an in-process local queue.
TASK_WORKER_ENABLED=false
TASK_QUEUE_LOCAL_FALLBACK=true
TASK_WORKER_AUTH_TOKEN=
TASK_WORKER_LEASE_SECONDS=600
TASK_WORKER_HEARTBEAT_INTERVAL_SECONDS=120
TASK_WORKER_MAX_ATTEMPTS=3
TASK_WORKER_RETRY_BASE_SECONDS=10
STALE_RUN_SWEEP_INTERVAL_SECONDS=60
DURABLE_SUBAGENTS_ENABLED=true
SUBAGENT_LEASE_SECONDS=600
SUBAGENT_HEARTBEAT_INTERVAL_SECONDS=120
SUBAGENT_MAX_MAILBOX_MESSAGES=32
SUBAGENT_PARENT_WAIT_SECONDS=300
DEEP_RESEARCH_WORKFLOW_ENABLED=false
DEEP_RESEARCH_WORKFLOW_MAX_SOURCES=6
TASK_EVENT_REPLAY_LIMIT=200
DEFAULT_AUTONOMY_MODE=manual
DEFAULT_TASK_BUDGET_CREDITS=1000
DEFAULT_TASK_MAX_RUNTIME_MINUTES=60
DEFAULT_TASK_MAX_TOOL_CALLS=80
IDLE_SANDBOX_PAUSE_SECONDS=300

# Cloud Tasks
GCP_TASKS_PROJECT_ID=
GCP_TASKS_LOCATION=us-central1
GCP_TASKS_QUEUE=cocomputer-tasks
# Full endpoint, for example https://agent.example.com/internal/tasks/run
GCP_TASKS_WORKER_URL=
GCP_TASKS_OIDC_SERVICE_ACCOUNT=
